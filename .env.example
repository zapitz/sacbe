# Copia este archivo a .env (chmod 600) y cámbialo. Nunca lo subas al repositorio.
# Lo leen pasarela-ia-api, pasarela-ia-panel y pasarela-ia-sacbe, y docker compose para armar compose.yaml.
# Todos los valores de aquí son de ejemplo.

# Contraseña de Postgres. La usa el contenedor pasarela-ia-db al crearse.
PIA_DB_CLAVE=cambia-esta-clave-larga

# Conexión a la base. La clave debe ser la misma de PIA_DB_CLAVE.
PIA_DB_URL=postgresql+psycopg://pasarela:cambia-esta-clave-larga@pasarela-ia-db:5432/pasarela

# Organizaciones de la consola de Anthropic, en orden, como nombre:tipo separados por comas.
# gratis: la organización no tiene tarjeta y nunca cobra. pagado: puede cobrar a una tarjeta.
# Nombres en minúsculas, con números y guiones.
PIA_FUENTES=org1:gratis,org2:pagado

# Una llave de API de Anthropic por organización: PIA_LLAVE_<NOMBRE en mayúsculas, guiones como _>.
PIA_LLAVE_ORG1=sk-ant-api03-llave-falsa-de-org1
PIA_LLAVE_ORG2=sk-ant-api03-llave-falsa-de-org2

# IP y puerto donde se publica el panel interno de solo lectura. Solo 127.0.0.1 o una IP privada, nunca 0.0.0.0.
PIA_IP_PANEL=127.0.0.1
PIA_PUERTO_PANEL=8090

# Host del panel con login. Obligatorio en pasarela-ia-sacbe (sin él no arranca) y lo usa la nota del panel
# interno para decir dónde se hacen los cambios. No es secreto, por eso va aquí y no en sacbe.env.
PIA_SACBE_HOST=panel.example.com

# Opcionales. Los valores de abajo son los de por omisión.

# MXN por USD, solo para los avisos de gasto en pesos. Sin ella se usa 20 y el aviso lo dice.
# PIA_TIPO_CAMBIO=18.45
# Zona horaria para mostrar horas en el panel: nombre IANA (America/Mexico_City) o desfase fijo (-06:00). Por omisión UTC.
# PIA_ZONA_HORARIA=UTC
# URL de la API de Anthropic. Solo cámbiala para pruebas.
# PIA_ANTHROPIC_URL=https://api.anthropic.com
# Cada cuántos segundos se releen los proyectos y sus llaves de la base (0: nunca).
# PIA_REFRESCO_S=30
# Cuántos segundos queda marcada como agotada una organización que se quedó sin crédito.
# PIA_AGOTADA_S=3600
# Cada cuántos segundos se recalculan saldos, topes y orden de las organizaciones (0: nunca).
# PIA_ORDEN_S=60
# Cada cuántos segundos se relee /v1/models de Anthropic (0: nunca). 21600 son 6 horas.
# PIA_CATALOGO_S=21600
# A dónde pregunta el panel por la salud del gestor.
# PIA_PANEL_SALUD_URL=http://pasarela-ia-api:8080/salud

# Estas dos las pone compose.yaml en cada servicio; no las pongas aquí.
# PIA_PANEL=1   sirve /panel (pasarela-ia-panel y pasarela-ia-sacbe)
# PIA_SACBE=1   modo panel con login (solo pasarela-ia-sacbe). Acepta 1 o 0; cualquier otro valor no arranca.

# PIA_ACCESS_AUD, PIA_ACCESS_EQUIPO y PIA_PANEL_SECRETO van en sacbe.env, nunca aquí: con PIA_ACCESS_AUD
# definida, la API y el panel interno se niegan a arrancar.
